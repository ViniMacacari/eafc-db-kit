{
  "name": "eafc-db-kit",
  "version": "1.0.1",
  "description": "Read and write EA FC databases, squads, and career saves with TypeScript and JSON-compatible objects.",
  "license": "MIT",
  "author": "ViniMacacari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViniMacacari/api-eafc-files.git"
  },
  "homepage": "https://github.com/ViniMacacari/api-eafc-files#readme",
  "bugs": {
    "url": "https://github.com/ViniMacacari/api-eafc-files/issues"
  },
  "keywords": [
    "eafc",
    "ea-fc",
    "fifa",
    "database",
    "squad",
    "career-save",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/application",
    "dist/domain",
    "dist/infrastructure",
    "templates",
    "examples",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run check:package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "check:package": "node scripts/check-package.mjs",
    "read": "node examples/read-file.mjs",
    "write": "node examples/write-file.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
